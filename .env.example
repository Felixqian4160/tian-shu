# 天枢 (tian-shu) 环境变量配置
# 复制为 .env 并填入实际值

# 数据库路径
TIANSHU_DUCKDB_PATH=/media/felix/d/openclaw/data/db/tianshu_data.duckdb

# Tushare Pro Token (分钟数据下载)
TUSHARE_TOKEN=your_token_here

# 数据目录
TUSHARE_DATA_DIR=../tushare_quant/data
TDX_DIR=/path/to/tdx/vipdoc

# Web服务
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 私有配置 (可选)
CONFIG_PRIVATE_PATH=config.private.json
CUSTOM_STRATEGIES_PRIVATE_PATH=data/strategies/custom_strategies.private.json
